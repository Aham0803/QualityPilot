# ==============================================================================
# DQ-Steward AI Environment Configuration Template
# Copy this file to .env and configure for your target deployment environment.
# ==============================================================================

# Database Connection (Defaults to SQLite if omitted)
# For local SQLite:
DATABASE_URL=sqlite:///dq_steward.db
# For PostgreSQL / Docker Compose:
# DATABASE_URL=postgresql://steward_user:steward_password@localhost:5432/dq_steward_db

# LLM Provider Configuration (Optional - falls back to offline deterministic steward engine if not set)
# Option A: OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini

# Option B: Azure OpenAI Service
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Webhook Alerting (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxx/IncomingWebhook/yyy

# Application Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
